{
  "name": "thesharkapp",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --if-present build",
    "desktop:dev": "pnpm --filter desktop dev",
    "desktop:build": "pnpm --filter desktop installer",
    "desktop:check": "pnpm --filter desktop check",
    "e2e": "pnpm --filter web e2e",
    "pos:sync": "pnpm --filter pos-sync sync",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase --yes db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema app,public --level warning --fail-on error",
    "db:types": "node scripts/db-types.mjs write",
    "db:types:check": "node scripts/db-types.mjs check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-sql": "0.20.0",
    "supabase": "2.121.0"
  }
}
